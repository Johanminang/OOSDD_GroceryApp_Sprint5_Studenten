<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Grocery.App.ViewModels"
             xmlns:m="clr-namespace:Grocery.Core.Models;assembly=Grocery.Core"
             x:Class="Grocery.App.Views.ProductCategoriesView"
             x:DataType="vm:ProductCategoriesViewModel"
             Title="Producten per categorie">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- Titel -->
            <Label Text="{Binding Category.Name}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Gekoppelde producten -->
            <Label Text="Gekoppelde producten"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding ProductCategories}"
                            x:Name="LinkedProductsCollection"
                            EmptyView="Nog geen producten gekoppeld.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ProductCategory">
                        <Frame Padding="10"
                               Margin="0,5"
                               BorderColor="{AppThemeBinding Light=#ccc, Dark=#444}"
                               CornerRadius="10">
                            <HorizontalStackLayout>
                                <Label Text="{Binding Product.Name}"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Zoekbalk -->
            <SearchBar Placeholder="Zoek producten..."
                       TextChanged="OnSearchTextChanged"
                       SearchCommand="{Binding PerformSearchCommand}"
                       SearchCommandParameter="{Binding Text, Source={RelativeSource Self}}" />

            <!-- Beschikbare producten -->
            <Label Text="Beschikbare producten"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding AvailableProducts}"
                            x:Name="AvailableProductsCollection"
                            EmptyView="Geen beschikbare producten gevonden.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Product">
                        <Frame Padding="10"
                               Margin="0,5"
                               BorderColor="{AppThemeBinding Light=#ccc, Dark=#444}"
                               CornerRadius="10">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Button Text="➕"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductCategoriesViewModel}}, Path=AddProductCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
